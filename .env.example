# Vercel AI Gateway key that powers the "query me" chatbot.
# Get one at https://vercel.com/ai-gateway (or `vercel env pull` after linking).
AI_GATEWAY_API_KEY=

# Optional: override the chatbot failover chain (comma-separated Gateway
# model strings, best first). Defaults to gemini-2.5-flash → flash-lite.
# CHAT_MODELS=google/gemini-2.5-flash,google/gemini-2.5-flash-lite

# Optional but recommended: a free Google AI Studio key (aistudio.google.com
# → Get API key). Adds a direct-to-Google fallback pool (~10 req/min free)
# that kicks in when the Gateway free tier is rate-limited.
# GOOGLE_GENERATIVE_AI_API_KEY=

# ── Spotify (off-duty "non-mainstream songs" + "now listening") ──────────────
# Create an app at https://developer.spotify.com/dashboard.
# CLIENT_ID + CLIENT_SECRET alone power the song cards (public data).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# REFRESH_TOKEN powers the live "now listening" widget (your playback).
# Mint it once with:  node assets-src/spotify-auth.mjs
# (add http://127.0.0.1:8888/callback as a Redirect URI in the dashboard first)
SPOTIFY_REFRESH_TOKEN=

# PostHog web analytics (optional — analytics are off without it).
# Project API key from PostHog → Settings → Project → "Project API key" (phc_...).
NEXT_PUBLIC_POSTHOG_KEY=

# ── Guest book (off-duty feedback card; hidden without these) ─────────────────
# Supabase project → Settings → API Keys → "Secret keys" tab: an sb_secret_…
# key (or the legacy service_role JWT) goes in SERVICE_ROLE_KEY; it never
# reaches the browser. The publishable/anon key is useless here on purpose:
# the table has RLS with no policies. Run supabase/feedback.sql once in the
# SQL editor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. Read your notes privately at
#   GET /api/feedback  with header  Authorization: Bearer <token>
FEEDBACK_READ_TOKEN=
# Optional: Vercel sets this header on cron calls; the keep-alive route
# refuses everything else when it is present.
# CRON_SECRET=
# Optional: salt for the one-way IP hash used by the hourly rate limit.
# FEEDBACK_SALT=
